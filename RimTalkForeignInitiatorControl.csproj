<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameVersion Condition="'$(GameVersion)' == ''">1.6</GameVersion>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RimTalkForeignInitiatorControl</RootNamespace>
    <AssemblyName>RimTalkForeignInitiatorControl</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(GameVersion)/Assemblies</OutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Lib.Harmony.Ref" Version="2.*" PrivateAssets="All" />
      <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />

      <Reference Include="RimTalk">
          <HintPath>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3551203752\1.6\Assemblies\RimTalk.dll</HintPath>
          <Private>false</Private>
      </Reference>
  </ItemGroup>
</Project>
